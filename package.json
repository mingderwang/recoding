{
  "name": "recoding",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && bun run typecheck:tests",
    "test": "bun test",
    "typecheck:tests": "tsc --noEmit --types bun --module esnext --target es2022 --moduleResolution bundler --skipLibCheck src/tests/*.ts"
  },
  "dependencies": {
    "astro": "^7.3.5",
    "vexflow": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/bun": "^1.4.2",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.0"
  }
}
