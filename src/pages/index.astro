---
import '../styles/global.css';

const title = 'Recoding — sing, and see the score';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Record yourself singing and get the sheet music back." />
    <title>{title}</title>
  </head>
  <body>
    <main class="page">
      <header class="masthead">
        <h1>Recoding</h1>
        <p class="tagline">Record a melody. Read it back as sheet music.</p>
      </header>

      <section class="panel" id="capture-panel">
        <div class="readout">
          <div class="pitch-readout" id="pitch-readout" aria-live="off">—</div>
          <div class="pitch-label" id="pitch-label">listening</div>
        </div>

        <div class="level" role="meter" aria-label="Input level" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="level">
          <div class="level-fill" id="level-fill"></div>
        </div>

        <div class="timer" id="timer">0.0s</div>

        <label class="voice-range">
          <span>Your voice</span>
          <select id="voice-range">
            <option value="auto" selected>Any voice</option>
            <option value="bass">Bass / baritone</option>
            <option value="tenor">Tenor</option>
            <option value="alto">Alto</option>
            <option value="soprano">Soprano</option>
          </select>
          <span class="voice-range-note" id="voice-range-note">
            Narrows the pitches searched, so notes are not transposed an octave.
          </span>
        </label>

        <div class="controls">
          <button class="button button-primary" id="record" type="button">Record</button>
          <button class="button" id="stop" type="button" hidden>Stop</button>
          <button class="button button-quiet" id="demo" type="button">Try a demo melody</button>
          <button class="button button-quiet" id="restart" type="button" hidden>Record again</button>
        </div>

        <p class="status" id="status" role="status">
          Everything runs in this tab. Nothing is uploaded. The demo melody is a
          four-bar phrase in C major, with a leap, a held note and a rest, so
          you can see the whole pipeline work before allowing microphone access.
        </p>
        <div class="progress" id="progress" hidden><div class="progress-fill" id="progress-fill"></div></div>
      </section>

      <section class="panel results" id="results" hidden>
        <div class="summary" id="summary"></div>
        <div class="score-host" id="score-host"></div>

        <div class="playback">
          <button class="button" id="play" type="button">Play recording</button>
          <button class="button button-score" id="play-score" type="button" data-playing="false">Play transcription</button>
          <label class="transpose">
            <span>Transpose</span>
            <select id="transpose">
              <option value="-12">−12</option>
              <option value="-7">−7</option>
              <option value="-5">−5</option>
              <option value="-3">−3</option>
              <option value="-1">−1</option>
              <option value="0" selected>0</option>
              <option value="1">+1</option>
              <option value="3">+3</option>
              <option value="5">+5</option>
              <option value="7">+7</option>
              <option value="12">+12</option>
            </select>
          </label>
          <span class="hint" id="playhead-label"></span>
        </div>

        <div class="feedback" id="feedback">
          <p class="feedback-question">Was that the melody you sang?</p>
          <div class="controls">
            <button class="button button-quiet" id="feedback-good" type="button" data-verdict="good">
              Yes, correct
            </button>
            <button class="button button-quiet" id="feedback-bad" type="button" data-verdict="bad">
              No, wrong
            </button>
            <span class="hint" id="feedback-count"></span>
          </div>

          <div class="feedback-detail" id="feedback-detail" hidden>
            <p class="hint">What went wrong? Pick any that apply.</p>
            <div class="feedback-issues" id="feedback-issues"></div>
            <label class="feedback-comment">
              <span>Anything else</span>
              <textarea
                id="feedback-comment"
                rows="2"
                placeholder="Optional. Writing down the melody you sang is the single most useful thing you can do here."></textarea
              >
            </label>
          </div>

          <div class="controls">
            <button class="button" id="copy-feedback" type="button">Copy feedback report</button>
            <button class="button button-quiet" id="clear-feedback" type="button">Clear</button>
          </div>
          <p class="hint" id="feedback-status" role="status"></p>
        </div>

        <div class="controls exports">
          <button class="button button-quiet" id="download-midi" type="button">Download MIDI</button>
          <button class="button button-quiet" id="download-svg" type="button">Download SVG</button>
          <button class="button button-quiet" id="download-png" type="button">Download PNG</button>
          <button class="button button-quiet" id="download-audio" type="button">Download recording</button>
        </div>

        <details class="diagnostics">
          <summary>Diagnostics — where notes were lost</summary>
          <pre id="funnel" class="funnel"></pre>
          <p class="hint">
            Whether the pitch was never found, filtered away, or discarded for being
            short. Included in the feedback report above.
          </p>
        </details>
      </section>

      <footer class="notes">
        <h2>What this does</h2>
        <p>
          It looks for one pitch at a time, so it is built for a solo voice or a
          single melodic instrument. Chords will not come out right, and a
          recording with two people singing will be a mess.
        </p>
        <p>
          Pitches are detected with the McLeod method, snapped to the key it
          infers, and laid on the rhythmic grid that best fits your onsets. The
          tempo it prints is inferred, not measured, so check it against how you
          were actually singing.
        </p>
      </footer>
    </main>

    <!--
      Astro only bundles a <script> with a bare `src` (no type="module") or an
      imported entry. A hand-written `type="module" src="../..."` is copied to
      the HTML verbatim, so the built page shipped a dead relative path and no
      JavaScript at all. Importing the entry is what gets it bundled and
      hashed.
    -->
    <script>
      import '../scripts/app.ts';
    </script>
  </body>
</html>
